# MyGrowth Diet App backend — local development environment
# Copy to .env and adjust. NEVER commit real secrets.

NODE_ENV=development
PORT=4000

# Database (PostgreSQL 16, local trust auth)
DATABASE_URL=postgresql://postgres@localhost:5432/mygrowth_diet_plan?schema=public
# Used by `npm test` — the test suite migrates and truncates this database.
TEST_DATABASE_URL=postgresql://postgres@localhost:5432/mygrowth_diet_plan_test?schema=public

# Frontend origins allowed by CORS (comma separated). Must include the Flutter web origin.
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Public base URL used to build email links (verification / password reset)
APP_BASE_URL=http://localhost:4000

# JWT — generate strong random values for production (openssl rand -hex 32)
JWT_ACCESS_SECRET=dev_only_change_me_access_secret_0123456789abcdef0123456789abcdef
JWT_REFRESH_SECRET=dev_only_change_me_refresh_secret_0123456789abcdef0123456789
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
BCRYPT_ROUNDS=10

# Cookie name for the httpOnly refresh token cookie
REFRESH_COOKIE_NAME=mgdp_refresh

# Scheduler: secret required by POST /api/v1/cron/tick (platform cron / external scheduler)
CRON_SECRET=dev_only_change_me_cron_secret

# Email provider: "console" (default — logs the link, never sends) or "resend"
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="MyGrowth Diet App <no-reply@mygrowth.local>"

# File storage adapter: "local" (files under UPLOAD_DIR) or "s3"
# (any S3-compatible object store: Amazon S3, Cloudflare R2, Backblaze B2,
# Supabase Storage, MinIO). Objects stay private and are streamed through
# GET /api/v1/files/:id — no bucket policy or signed URL required.
STORAGE_ADAPTER=local
UPLOAD_DIR=./uploads
# Temporary directory for uploads that are on their way to object storage
# (defaults to the OS temp directory). Ignored by the local adapter.
# UPLOAD_TEMP_DIR=
# Maximum upload size in bytes (default 50 MB)
FILE_MAX_BYTES=52428800

# --- Object storage (only when STORAGE_ADAPTER=s3) ---
# Cloudflare R2 example:
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION=auto
# Amazon S3 example:
#   S3_ENDPOINT=              (leave empty)
#   S3_REGION=eu-west-1
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Path-style addressing: required by R2/B2/MinIO, accepted by S3.
S3_FORCE_PATH_STYLE=true
# Optional key prefix, e.g. "mygrowth/prod"
S3_PREFIX=

# Logging: info | warn | error | debug
LOG_LEVEL=info
# Optional: enables the authenticated MyGrowth AI Assistant. Keep this key on
# the backend host only; never place it in Flutter or a Vercel client env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
