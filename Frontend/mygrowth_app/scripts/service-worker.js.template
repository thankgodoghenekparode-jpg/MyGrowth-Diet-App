/* Build replaces __BUILD_ID__ with a hash of Flutter's precache manifest. */
const BUILD_ID = '__BUILD_ID__';
const CACHE_NAME = `mygrowth-shell-${BUILD_ID}`;
const CACHE_PREFIX = 'mygrowth-shell-';

self.addEventListener('install', (event) => {
  event.waitUntil((async () => {
    const base = self.registration.scope;
    const manifestUrl = new URL('precache_manifest.json', base);
    const response = await fetch(manifestUrl, { cache: 'no-store' });
    if (!response.ok) throw new Error('Could not load offline asset manifest');
    const manifest = await response.json();
    const urls = (manifest.entries || []).map((entry) => new URL(entry.url, base).href);
    urls.push(new URL('index.html', base).href, new URL('manifest.json', base).href);
    const uniqueUrls = [...new Set(urls)];
    const cache = await caches.open(CACHE_NAME);
    await cache.addAll(uniqueUrls);
    const index = await cache.match(new URL('index.html', base).href);
    if (index) await cache.put(base, index.clone());
    await self.skipWaiting();
  })());
});

self.addEventListener('activate', (event) => {
  event.waitUntil((async () => {
    const names = await caches.keys();
    await Promise.all(names
      .filter((name) => name.startsWith(CACHE_PREFIX) && name !== CACHE_NAME)
      .map((name) => caches.delete(name)));
    await self.clients.claim();
  })());
});

self.addEventListener('fetch', (event) => {
  const request = event.request;
  if (request.method !== 'GET') return;
  const url = new URL(request.url);
  const base = new URL(self.registration.scope);
  if (url.origin !== base.origin || url.pathname.startsWith('/api/')) return;

  if (request.mode === 'navigate') {
    event.respondWith((async () => {
      try {
        return await fetch(request);
      } catch (_) {
        const cache = await caches.open(CACHE_NAME);
        return (await cache.match(request)) ||
          (await cache.match(base.href)) ||
          (await cache.match(new URL('index.html', base).href));
      }
    })());
    return;
  }

  event.respondWith((async () => {
    const cached = await caches.match(request);
    if (cached) return cached;
    const response = await fetch(request);
    if (response.ok && url.origin === base.origin) {
      const cache = await caches.open(CACHE_NAME);
      await cache.put(request, response.clone());
    }
    return response;
  })());
});
