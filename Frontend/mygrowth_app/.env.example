# Frontend build-time configuration.
# Flutter reads these via --dart-define at build/run time (NOT dart-define-file).
#
# API_BASE_URL — public base URL of the MyGrowth backend (no secrets here).
#   Local development:  http://localhost:4000/api/v1
#   Production:         https://your-api.example.com/api/v1
API_BASE_URL=http://localhost:4000/api/v1

# Example:
#   flutter run --dart-define=API_BASE_URL=http://localhost:4000/api/v1
#   flutter build web --release --dart-define=API_BASE_URL=https://api.example.com/api/v1
